# Copie para .env na raiz ou para backend/.env
# Nunca commite chaves ou connection strings reais.

# Postgres — apenas metadados operacionais (sem conteúdo processual).
# Local (docker compose): postgresql+asyncpg://veritas:veritas@127.0.0.1:5433/veritas_ai
# Produção: connection string do Neon.
DATABASE_URL=postgresql+asyncpg://veritas:veritas@127.0.0.1:5433/veritas_ai

# Sessão in-memory. Após o TTL o JSON extraído e o Excel são descartados.
JOB_TTL_SECONDS=900
MAX_UPLOAD_MB=80

# Gemini — classificação e extração nas páginas candidatas (máx. 5 chamadas).
# Sem chave, a triagem local roda mas as candidatas não são classificadas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS do frontend de desenvolvimento
FRONTEND_ORIGIN=http://127.0.0.1:4174
