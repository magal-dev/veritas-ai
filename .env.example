# Copie para .env na raiz ou para backend/.env
# Nunca commite chaves ou connection strings reais.

# Postgres — apenas metadados operacionais (sem conteúdo processual).
# Local (docker compose): postgresql+asyncpg://tcc:tcc@127.0.0.1:5433/tcc_pjecalc
# Produção: connection string do Neon.
DATABASE_URL=postgresql+asyncpg://tcc:tcc@127.0.0.1:5433/tcc_pjecalc

# Sessão in-memory. Após o TTL o JSON extraído e o Excel são descartados.
JOB_TTL_SECONDS=900
MAX_UPLOAD_MB=80

# Gemini — não usado nesta fundação. Preencher em iterações futuras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS do frontend de desenvolvimento
FRONTEND_ORIGIN=http://127.0.0.1:4174
